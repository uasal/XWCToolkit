/** \file config.h
 * \brief Build-time configuration for XWCToolkit
 * 
 * This file is automatically generated by CMake during the build.
 * It contains build-time settings that affect compilation.
 */

#ifndef xwctk_config_h
#define xwctk_config_h

// Build configuration
#define XWCTK_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define XWCTK_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define XWCTK_VERSION_PATCH @PROJECT_VERSION_PATCH@

// Installation paths (configured at build time)
#define XWCTK_PREFIX "@XWCTK_PREFIX@"
#define XWCTK_APPS_PATH "@XWCTK_APPS_PATH@"
#define PREFIX "@PREFIX@"

// Build options
#cmakedefine MXLIB_MILK

// Build type indicator
#cmakedefine CMAKE_BUILD_TYPE "@CMAKE_BUILD_TYPE@"

#endif // xwctk_config_h
